.player-stats-holder {
    flex-grow: 1;
    width: 13%;
    height: 30%;
    position: absolute;
    bottom: 0;
    flex-direction: row;
    justify-content: space-around;
    background-image: url("Inventory Panel2.svg");
}

.health-bar {
    flex-grow: 1;
    position: relative;
    background-image: url("scrollbar_future_red.svg");
}

.stamina-bar {
    flex-grow: 1;
    position: relative;
    background-image: url("scrollbar_future_grey.svg");
}

.health-fill {
    height: 100%;
    width: 100%;
    background-color: rgba(255,0,0,0.7);
}

.stamina-fill {
    height: 100%;
    width: 100%;
    background-color: rgba(0,150,255,0.7);
}
